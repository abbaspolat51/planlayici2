rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Kişisel veriler: herkes yalnızca kendi verisini okuyup yazabilir
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Gruplar: belge adı davet kodudur
    match /groups/{gid} {
      function isMember() {
        return request.auth != null && request.auth.uid in resource.data.members;
      }
      // Kodu bilen giriş yapmış kişi grubu görebilir (listeleme yok)
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      // Üyeler grubu güncelleyebilir; üye olmayan yalnızca kendini ekleyebilir
      allow update: if isMember() || (
        request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names', 'roles'])
        && request.resource.data.members.removeAll(resource.data.members).hasOnly([request.auth.uid])
        && resource.data.members.removeAll(request.resource.data.members).size() == 0
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.owner;

      // Üye istatistikleri, atanan görevler: yalnızca grup üyeleri
      match /{sub=**} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.members;
      }
    }
  }
}
