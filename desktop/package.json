{
  "name": "planlayici-masaustu",
  "version": "2.3.0",
  "description": "Planlayıcı - Windows masaüstü uygulaması",
  "main": "main.js",
  "author": "abbaspolat51",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.abbaspolat51.planlayici",
    "productName": "Planlayici",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "offline.html",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "Planlayici-Kurulum.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Planlayıcı",
      "uninstallDisplayName": "Planlayıcı"
    },
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/abbaspolat51/planlayici2.git"
  }
}
